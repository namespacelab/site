{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/ai-automation-sprint",
   "destination": "/services/ai-automation",
   "permanent": true
  },
  {
   "source": "/salesforce-admin-dev-retainer",
   "destination": "/services/salesforce/admin-support",
   "permanent": true
  },
  {
   "source": "/mvp-development",
   "destination": "/services/web-app-development",
   "permanent": true
  },
  {
   "source": "/pilot-program",
   "destination": "/services",
   "permanent": true
  },
  {
   "source": "/services/web-development",
   "destination": "/services/web-app-development",
   "permanent": true
  },
  {
   "source": "/services/ios-android-apps",
   "destination": "/services/mobile-app-development",
   "permanent": true
  },
  {
   "source": "/services/custom-ai-apps",
   "destination": "/services/ai-powered-apps",
   "permanent": true
  },
  {
   "source": "/services/software-engineering",
   "destination": "/services/software-development",
   "permanent": true
  },
  {
   "source": "/industries/waste-management",
   "destination": "/industries/solid-waste-management",
   "permanent": true
  },
  {
   "source": "/case-studies",
   "destination": "/work",
   "permanent": true
  },
  {
   "source": "/index",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/home",
   "destination": "/",
   "permanent": true
  },
  {
   "source": "/lab",
   "destination": "/work",
   "permanent": true
  },
  {
   "source": "/services/salesforce-admin-development",
   "destination": "/services/salesforce",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    },
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin"
    },
    {
     "key": "Cross-Origin-Resource-Policy",
     "value": "same-origin"
    }
   ]
  },
  {
   "source": "/assets/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(art|img)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=2592000"
    }
   ]
  },
  {
   "source": "/assets/(.*)\\.(css|js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(.*)\\.(svg|png)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/(llms.txt|robots.txt|sitemap.xml)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  }
 ]
}